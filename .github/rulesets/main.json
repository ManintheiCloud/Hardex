        {"context": "kind", "integration_id": 15368},
        {"context": "corpus", "integration_id": 15368},
        {"context": "test (ubuntu-24.04)", "integration_id": 15368},
        {"context": "test (ubuntu-24.04-arm)", "integration_id": 15368},
        {"context": "test (macos-15)", "integration_id": 15368},
        {"context": "test (windows-2025)", "integration_id": 15368},
        {"context": "Analyze (go)", "integration_id": 15368}
      ]
    }}
  ]
